<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Si la requete commence deja par /public/, ne pas la reecrire (eviter boucle)
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^ - [L]

    # 2. Trailing slash redirect (SEO) UNIQUEMENT sur les GET. Un POST avec trailing
    #    slash (ex: webhook Stripe mal configure) ne doit JAMAIS etre redirige en 301
    #    car les clients HTTP suivent la redirection en GET, ce qui casse les webhooks.
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^/(.+)/$
    RewriteRule ^ /%1 [L,R=301]

    # 3. Reecrire toutes les requetes vers public/ pour preserver le path original.
    #    Le public/.htaccess fera ensuite la rewrite vers index.php pour le routing Laravel.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Empecher mod_dir d'ajouter automatiquement un slash final qui declencherait
# un 301 vers /public/ apres une rewrite interne.
DirectorySlash Off
